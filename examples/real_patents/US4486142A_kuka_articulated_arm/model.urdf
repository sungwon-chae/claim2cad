      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </visual>
  </link>
  <joint name="_attach_control_means_to_closed_loop" type="fixed">
    <parent link="control_means"/>
    <child link="closed_loop"/>
    <origin xyz="0.1200 0.0000 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_control_means_to_controlled_variable" type="fixed">
    <parent link="control_means"/>
    <child link="controlled_variable"/>
    <origin xyz="0.0600 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_control_means_to_limited_level" type="fixed">
