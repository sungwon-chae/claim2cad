{
  "schema_version": "0.1.0",
  "title": "Speed change mechanism",
  "claims": [
    {
      "id": "claim_1",
      "text": "1. A speed change mechanism comprising; a stationary housing; an input shaft rotatably mounted in said housing; planet carrier means drivingly connected with said input shaft and including first and second mounting means eccentric to each other; an output shaft rotatably journaled in said housing; a first ring gear drivingly connected with said output shaft; a second ring gear secured to said housing; a first planet pinion rotatably on said first mounting means and meshing with said first ring gear; a second planet pinion rotatably mounted on said second mounting means with the center line thereof in a position eccentric with said first planet pinion and meshing with said second ring gear; and a third planet pinion rotatably mounted on said carrier means and meshing with said first and second planet pinions at points tangent to the pitch diameters of said first and second planet pinions to transmit rotary motion from one of said planet pinions to said other of said planet pinions.",
      "is_independent": true,
      "depends_on": null
    }
  ],
