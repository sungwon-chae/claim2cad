{
  "schema_version": "0.1.0",
  "title": "Planetary gear assembly",
  "claims": [
    {
      "id": "claim_1",
      "text": "A planetary gear assembly, comprising: a sun gear having a plurality of external teeth; a ring gear having a plurality of internal teeth, the ring gear coaxially surrounding the sun gear; a carrier rotatably disposed between the sun gear and the ring gear; a first planet gear rotatably mounted on the carrier and meshed with both the sun gear and the ring gear; a second planet gear rotatably mounted on the carrier and meshed with both the sun gear and the ring gear; a third planet gear rotatably mounted on the carrier and meshed with both the sun gear and the ring gear; wherein the carrier rotates about a central axis when the sun gear is driven and the ring gear is held stationary.",
      "is_independent": true,
      "depends_on": null
    },
    {
      "id": "claim_2",
      "text": "The planetary gear assembly of claim 1, further comprising an input shaft fixedly attached to the sun gear.",
      "is_independent": false,
      "depends_on": "claim_1"
    }
  ],
