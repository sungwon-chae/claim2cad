  </link>
  <joint name="_attach_housing_to_epicyclic_gear_train" type="fixed">
    <parent link="housing"/>
    <child link="epicyclic_gear_train"/>
    <origin xyz="0.0600 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_first_gear" type="fixed">
    <parent link="housing"/>
    <child link="first_gear"/>
    <origin xyz="0.1800 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_first_shaft" type="fixed">
    <parent link="housing"/>
    <child link="first_shaft"/>
    <origin xyz="0.1200 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_flow_control_valve" type="fixed">
    <parent link="housing"/>
    <child link="flow_control_valve"/>
    <origin xyz="0.0600 0.0600 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_inlet_port" type="fixed">
    <parent link="housing"/>
    <child link="inlet_port"/>
    <origin xyz="0.0600 0.0000 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_outlet_port" type="fixed">
    <parent link="housing"/>
    <child link="outlet_port"/>
    <origin xyz="0.1200 0.0000 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_pumping_unit" type="fixed">
    <parent link="housing"/>
