{
  "schema_version": "0.1.0",
  "title": "Articulated robotic manipulator",
  "claims": [
    {
      "id": "claim_1",
      "text": "An articulated robotic manipulator, comprising: a base; a first link rotatably mounted on the base via a first revolute joint; a second link rotatably coupled to the first link via a second revolute joint; an end effector attached to a distal end of the second link; and a fastener securing the base to a mounting surface; wherein each of the first and second revolute joints has a single degree of rotational freedom; and wherein the end effector includes a gripper.",
      "is_independent": true,
      "depends_on": null
    },
    {
      "id": "claim_2",
      "text": "The articulated robotic manipulator of claim 1, further comprising a position sensor coupled to the second link.",
      "is_independent": false,
      "depends_on": "claim_1"
    }
  ],
