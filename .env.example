# Copy to .env and fill in your values.
#
# This file is OPTIONAL. The default demo (`make demo-clean-checkout`)
# never calls an LLM — it replays cached expected_ir.json files. Set the
# OpenRouter key only if you want to parse new claims at runtime.
#
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_VISION_MODEL=anthropic/claude-opus-4.7

# Optional: override the default base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: cap cumulative LLM spend per session (USD). When exceeded,
# claim2cad.cost_tracker auto-downgrades heavy tasks to Sonnet.
# CLAIM2CAD_COST_SOFT_CAP=60

# Optional: set to 1 to enable verbose request/response logging.
# CLAIM2CAD_DEBUG_LLM=0
