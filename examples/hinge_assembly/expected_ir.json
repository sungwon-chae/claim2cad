{
  "schema_version": "0.1.0",
  "title": "Four-bar linkage mechanism",
  "claims": [
    {
      "id": "claim_1",
      "text": "A four-bar linkage mechanism, comprising: a fixed link; a first rotating link pivotally connected to the fixed link at a first revolute joint; a coupler link pivotally connected to the first rotating link at a second revolute joint; a second rotating link pivotally connected to the coupler link at a third revolute joint and to the fixed link at a fourth revolute joint; wherein the four revolute joints define a planar four-bar linkage that converts rotational motion of the first rotating link into a constrained planar motion of the coupler link.",
      "is_independent": true,
      "depends_on": null
    }
  ],
