    <child link="second_gear"/>
    <origin xyz="0.3000 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_housing_to_second_shaft" type="fixed">
    <parent link="housing"/>
    <child link="second_shaft"/>
    <origin xyz="0.2400 -0.0900 0.0000" rpy="0 0 0"/>
