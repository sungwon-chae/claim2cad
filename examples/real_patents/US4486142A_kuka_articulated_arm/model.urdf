<?xml version="1.0" ?>
<robot name="method_of_automatic_limitation_for_one_controlled_variable_of_a_multivariable_controlled_object">
  <link name="closed_loop">
    <visual>
      <geometry>
        <box size="0.014 0.014 0.014"/>
      </geometry>
    </visual>
  </link>
  <link name="control_means">
    <visual>
      <geometry>
        <box size="0.03 0.024 0.01"/>
      </geometry>
    </visual>
  </link>
  <link name="controlled_variable">
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </visual>
  </link>
  <link name="limited_level">
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </visual>
  </link>
  <link name="multivariable_controlled_object">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
    </visual>
  </link>
  <link name="preestablished_deviation">
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </visual>
  </link>
  <link name="set_point">
