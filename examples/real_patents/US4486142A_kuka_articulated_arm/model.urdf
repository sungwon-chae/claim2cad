    <origin xyz="0.1800 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_control_means_to_multivariable_controlled_object" type="fixed">
    <parent link="control_means"/>
    <child link="multivariable_controlled_object"/>
    <origin xyz="0.1200 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_control_means_to_preestablished_deviation" type="fixed">
    <parent link="control_means"/>
    <child link="preestablished_deviation"/>
    <origin xyz="0.2400 -0.0900 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="_attach_control_means_to_set_point" type="fixed">
