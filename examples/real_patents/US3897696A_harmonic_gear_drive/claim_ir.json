{
  "schema_version": "0.1.0",
  "title": "Self-adjustable gear train transmission",
  "claims": [
    {
      "id": "claim_1",
      "text": "1. In a transmission including two gear trains having intermediate shafts driven by a single drive shaft through at least one respective transmission stage and carrying at least one pinion, respectively, meshing with a gear located between the two intermediate drive shafts each gear train being connectible to a machine driven by the transmission, means to make the meshing of the gear trAins to the driven machine self adjustable, comprising a pair of frames wherein the transmission stages are disposed, each of said frames being mounted on one of the intermediate shafts, and each being articulatingly connected on the other hand to the frame mounted on the other intermediate shaft, each of the frames being pivotally mounted and articulatingly connected about the drive shaft.",
      "is_independent": true,
      "depends_on": null
    }
  ],
